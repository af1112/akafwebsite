{
    "version": 2,
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python",
            "config": {
                "runtime": "python3.10"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/(dashboard|admin|accounts|expenses|ticketing|attendance|users|restore-data|run-migrations|ping|static|media)(.*)",
            "destination": "/api/index.py"
        }
    ]
}
